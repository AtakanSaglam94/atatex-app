{
  "name": "atatex-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Application de gestion ATA-TEX — commerce de tissus, voilages, rideaux, tentures et stores (Bruxelles)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:shop": "tsc -b && vite build --mode shop",
    "preview": "vite preview",
    "preview:shop": "vite preview --outDir dist-shop",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vite-plugin-pwa": "^0.20.5"
  }
}
